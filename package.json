{
  "name": "simple-share",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=24" },
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:vercel": "pnpm test && convex deploy --cmd 'pnpm build' --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL",
    "start": "next start",
    "test": "node --test lib/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "0.3.2",
    "convex": "1.45.0",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "5.9.3"
  }
}
